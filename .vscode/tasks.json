{
  // Run with Terminal > Run Task... (conda must work in the VS Code terminal; see bench/README.md).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Env: create",
      "detail": "First-time setup: create the columbia-study conda env from environment.yml",
      "type": "shell",
      "command": "conda env create --file environment.yml",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Env: update",
      "detail": "Sync the existing env after environment.yml changes (use Env: create the first time)",
      "type": "shell",
      "command": "conda env update --name columbia-study --file environment.yml --prune",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Env: check",
      "detail": "Confirm the env exists and its packages import",
      "type": "shell",
      "command": "conda run --name columbia-study python -c \"import sys, numpy, pyxdf, pylsl; print(sys.version); print('numpy', numpy.__version__, '| pyxdf', pyxdf.__version__, '| pylsl', pylsl.__version__, '| liblsl', pylsl.library_version())\"",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Bench: launch streamers",
      "detail": "Start one NEDeviceStreamer per device in bench/devices.json (Windows)",
      "type": "shell",
      "command": "conda run --no-capture-output --name columbia-study python bench/launch_streamers.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Bench: check streams",
      "detail": "List LSL streams and measure rates and timestamp delays",
      "type": "shell",
      "command": "conda run --no-capture-output --name columbia-study python bench/check_streams.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Bench: analyze recording",
      "detail": "Data gaps and tap timing for a LabRecorder XDF file",
      "type": "shell",
      "command": "conda run --no-capture-output --name columbia-study python bench/analyze_recording.py \"${input:xdfPath}\"",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "xdfPath",
      "type": "promptString",
      "description": "Path to the .xdf recording"
    }
  ]
}
