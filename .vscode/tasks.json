{
  // Run with Terminal > Run Task... (conda must work in the VS Code terminal; see bench/README.md).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Env: create",
      "detail": "First-time setup: create the lab-intercom-study-cu conda env from environment.yml",
      "type": "shell",
      "command": "conda env create --file environment.yml",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Env: update",
      "detail": "Rebuild the env from environment.yml after it changes (conda env update skips new packages' dependencies on conda 24.11)",
      "type": "shell",
      "command": "conda env create --file environment.yml --yes",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Env: check",
      "detail": "Confirm the env exists and its packages import",
      "type": "shell",
      "command": "conda run --name lab-intercom-study-cu python -c \"import sys, numpy, pyxdf, pylsl; print(sys.version); print('numpy', numpy.__version__, '| pyxdf', pyxdf.__version__, '| pylsl', pylsl.__version__, '| liblsl', pylsl.library_version())\"",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Manifest: check",
      "detail": "Validate a session manifest and print its fields, example file name and slots",
      "type": "shell",
      "command": "conda run --no-capture-output --name lab-intercom-study-cu python -m session_monitor.manifest \"${input:manifestPath}\"",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Session: GUI",
      "detail": "Browser page at http://127.0.0.1:8080: slot cards, identifiers, record/stop, notes, live log (Ctrl+C here quits)",
      "type": "shell",
      "command": "conda run --no-capture-output --name lab-intercom-study-cu python -u -m session_monitor.gui \"${input:manifestPath}\" --out data",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Session: terminal",
      "detail": "Monitor a manifest's streams, confirm slots, record with LabRecorderCLI (type ? for commands)",
      "type": "shell",
      "command": "conda run --no-capture-output --name lab-intercom-study-cu python -u -m session_monitor.cli \"${input:manifestPath}\" --out data",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Fakes: publish bench streams",
      "detail": "Rehearse without tablets: fake NIC2 streams from manifests/bench.yaml + data/bench_local.yaml (hosts = this computer)",
      "type": "shell",
      "command": "conda run --no-capture-output --name lab-intercom-study-cu python -m session_monitor.fakes manifests/bench.yaml --local-manifest data/bench_local.yaml",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Bench: check streams",
      "detail": "List the NIC2 LSL streams and measure rates and timestamp delays (recording PC)",
      "type": "shell",
      "command": "conda run --no-capture-output --name lab-intercom-study-cu python bench/check_streams.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Bench: analyze recording",
      "detail": "Data gaps and tap timing for a LabRecorder XDF file",
      "type": "shell",
      "command": "conda run --no-capture-output --name lab-intercom-study-cu python bench/analyze_recording.py \"${input:xdfPath}\"",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "manifestPath",
      "type": "promptString",
      "description": "Path to the session manifest",
      "default": "manifests/bench.yaml"
    },
    {
      "id": "xdfPath",
      "type": "promptString",
      "description": "Path to the .xdf recording"
    }
  ]
}
